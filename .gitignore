# Build output and tooling scratch
dist/
qa-shots/
build-report.json

# macOS
.DS_Store

# The Wayback crawl is kept locally for reference, but is deliberately NOT
# published. Portions of the captured HTML contain verbatim third-party
# patient-information text (ASCRS, NHS and others) that is not ours to
# redistribute, and the raw files are large and machine-generated. The
# extracted, practice-authored text is committed separately in
# _archive/content-extracted/ so the rebuild stays reproducible.
_archive/html/
_archive/media/
_archive/pages.json
_archive/assets.txt
_archive/media-urls.txt
_archive/content/

# Editor and environment noise
*.swp
.env
.env.*

# impeccable-ignore-start
# Ephemeral output and per-developer state from the Impeccable design tools.
# Shared artifacts stay tracked: config.json, design.json, surfaces/*.md,
# critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
